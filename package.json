{
  "name": "industrial-asset-maintenance-saas",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration --filter=@iam/api",
    "test:e2e": "turbo run test:e2e --filter=@iam/web",
    "test:prepare": "node scripts/prepare-test-database.mjs",
    "coverage": "pnpm --filter @iam/api coverage && pnpm --filter @iam/shared coverage && pnpm --filter @iam/web coverage",
    "verify:fast": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "verify:full": "pnpm verify:fast && pnpm test:prepare && pnpm test:integration && pnpm build && pnpm coverage && pnpm test:e2e && pnpm audit --prod --audit-level high",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "prisma": "7.9.1",
    "turbo": "^2.5.0",
    "typescript-eslint": "^8.18.0"
  }
}
